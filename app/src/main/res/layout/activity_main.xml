<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/pb_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="64dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:src="@drawable/probenk_logo_white"
            android:contentDescription="ProBenk" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Mobil-widget"
            android:textColor="@color/pb_white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Lag en engangskode på siden Mobil-widget i ProBenk-portalen, og skriv den inn her."
            android:textColor="@color/pb_muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Portaladresse"
            android:textColor="@color/pb_white"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/baseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/pb_orange"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@color/pb_white"
            android:textColorHint="@color/pb_muted"
            android:hint="https://probenk.no/admin/" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="8-sifret engangskode"
            android:textColor="@color/pb_white"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/pairCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/pb_orange"
            android:inputType="number"
            android:maxLength="8"
            android:singleLine="true"
            android:textColor="@color/pb_white"
            android:textColorHint="@color/pb_muted"
            android:hint="12345678" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:text="Koble til"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/pb_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Gjennomsiktighet på widgetbakgrunn"
            android:textColor="@color/pb_white"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/transparencySeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/pb_orange"
                android:thumbTint="@color/pb_orange" />

            <TextView
                android:id="@+id/transparencyValue"
                android:layout_width="58dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0 %"
                android:textColor="@color/pb_white"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 % = som nå · 100 % = helt gjennomsiktig bakgrunn"
            android:textColor="@color/pb_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:text="Test / oppdater widget"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
